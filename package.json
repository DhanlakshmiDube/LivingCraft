{
  "name": "livingcraft",
  "version": "1.0.0",
  "description": "LivingCraft - Fullstack Interior Design & Room Planning Platform",
  "scripts": {
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "server": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "install:client": "npm --prefix client install",
    "install:server": "npm --prefix server install",
    "install:all": "npm run install:server && npm run install:client",
    "dev": "node scripts/start-dev.js"
  },
  "keywords": [
    "interior-design",
    "react",
    "vite",
    "express",
    "mongodb",
    "fullstack"
  ],
  "author": "LivingCraft Team",
  "license": "ISC"
}
